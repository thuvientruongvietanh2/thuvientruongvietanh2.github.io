 background:#ffffff0d;display:flex;flex-direction:column;align-items:center;
 justify-content:center;cursor:pointer;transition:.2s;padding:14px;
}
.obj:hover{transform:translateY(-4px);background:#ffffff18;border-color:#f5c85b}
.obj .emoji{font-size:52px}
.obj strong{margin-top:8px}
.obj small{color:#cfc6e6;margin-top:5px;text-align:center}
.clue{
 margin:20px auto 0;max-width:600px;text-align:center;
 background:#171332;border:1px dashed #f5c85b;border-radius:16px;padding:17px;
}
.number{font-size:40px;color:#ffe99a;font-weight:800;margin-top:5px}
.next{display:block;margin:18px auto 0}
.codeBox{text-align:center}
.codeInputs{display:flex;justify-content:center;gap:10px;margin:22px 0}
.codeInputs input{
