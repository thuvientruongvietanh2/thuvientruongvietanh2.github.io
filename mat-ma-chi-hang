}
.wrap{width:min(980px,94%);margin:auto;padding:28px 0 40px}
.header{text-align:center}
.badge{display:inline-block;background:#f5c85b;color:#352454;padding:7px 14px;border-radius:99px;font-weight:700;font-size:13px}
h1{font-size:clamp(30px,6vw,52px);margin:12px 0 5px;color:#ffe99a}
