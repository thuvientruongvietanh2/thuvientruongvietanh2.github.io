<style>
*{box-sizing:border-box}
body{
  margin:0;font-family:Arial,sans-serif;
  background:linear-gradient(135deg,#17143b,#2c2260 55%,#4a357a);
  min-height:100vh;color:#fff;overflow-x:hidden;
