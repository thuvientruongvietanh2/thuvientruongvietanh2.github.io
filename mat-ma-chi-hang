<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Ô Chữ Trung Thu - Mật Mã Dọc</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:linear-gradient(135deg,#fff4d8,#ffe8f0,#e8ddff);color:#463652}
.wrap{max-width:1100px;margin:auto;padding:20px 14px 40px}
.card{background:#fffdf8;border-radius:26px;padding:22px;box-shadow:0 10px 30px rgba(90,60,90,.12)}
h1{text-align:center;margin:0;color:#744b83;font-size:clamp(28px,5vw,44px)}
.subtitle{text-align:center;font-weight:800;color:#a26b43;margin:6px 0 20px}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:18px}
.board{background:#fff;border-radius:18px;padding:16px;overflow-x:auto;border:1px solid #eadfe5}
.row{height:49px;display:flex;align-items:center;margin:5px 0;min-width:650px}
.num{width:42px;text-align:center;font-weight:900;color:#895b75;flex:0 0 42px}
.cells{display:flex;height:45px}
.cell{width:45px;height:45px;border:2px solid #475268;background:#fff}
.cell.key{background:#f6dda0;border-color:#9d762e}
.cell input{width:100%;height:100%;border:0;outline:0;background:transparent;text-align:center;font-size:21px;font-weight:900;text-transform:uppercase;color:#3e4250}
.cell input:focus{background:#fff3c5;box-shadow:inset 0 0 0 3px #efbd4f}
.clues{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.clue{background:#fff1f5;border-radius:10px;padding:9px;font-size:13px;line-height:1.35}
.clue b{color:#744b83}
.secret{background:#fff8df;border:2px solid #e1c36a;border-radius:20px;padding:16px;text-align:center;height:max-content}
.secret h2{margin:0 0 12px;color:#80552b;font-size:19px}
.secret-grid{display:flex;flex-direction:column;gap:5px;align-items:center}
.secret-box{width:48px;height:38px;border:2px solid #d3a33e;border-radius:8px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;color:#9b7028}
.secret-space{height:9px;border:0;background:transparent}
.note{font-size:12px;line-height:1.45;color:#76654e;margin-top:12px}
.score{font-weight:900;margin:12px 0}
.actions{display:flex;gap:8px;margin-top:14px}
button{border:0;border-radius:12px;padding:12px 18px;font-weight:900;font-size:16px;cursor:pointer;min-height:46px}
.check{background:#e8759a;color:white}.reset{background:#eee5f2;color:#704b78}
.msg{text-align:center;min-height:25px;margin-top:10px;font-weight:800}
@media(max-width:760px){
.layout{grid-template-columns:1fr}.secret{order:-1}.secret-grid{flex-direction:row;flex-wrap:wrap;justify-content:center}
.secret-space{width:10px;height:38px}.clues{grid-template-columns:1fr}.board{padding:10px}.cell{width:40px;height:40px}.cells{height:40px}.row{height:44px}.cell input{font-size:19px}
}
</style>
</head>
<body>
<div class="wrap">
<div class="card">
<h1>🌕 Ô CHỮ TRUNG THU</h1>
<div class="subtitle">🔐 MẬT MÃ DỌC</div>

<div class="layout">
<div>
<div class="board" id="board"></div>
<div class="clues" id="clues"></div>
<div class="actions">
<button class="check" id="check">🔍 KIỂM TRA</button>
<button class="reset" id="reset">↻ CHƠI LẠI</button>
</div>
<div class="msg" id="msg" aria-live="polite"></div>
</div>

<aside class="secret">
<h2>🔐 MẬT MÃ DỌC</h2>
<div class="secret-grid" id="secret"></div>
<div class="score">⭐ Điểm: <span id="score">0</span>/8</div>
<div class="note">Các chữ trong ô vàng sẽ hiện <b>đúng thứ tự từ trên xuống dưới</b>, tạo thành mật mã:</div>
<div style="font-size:18px;font-weight:900;color:#8a4f9f;margin-top:7px">TRĂNG RẰM</div>
</aside>
</div>
</div>
</div>

<script>
const data=[
 {answer:"TRĂNG",clue:"Vật tròn sáng xuất hiện trên bầu trời đêm Trung Thu.",key:0,offset:0},
 {answer:"RƯỚC ĐÈN",clue:"Hoạt động vui chơi quen thuộc của trẻ em trong đêm Trung Thu.",key:0,offset:1},
 {answer:"MẶT TRĂNG",clue:"Tên gọi quen thuộc của vật thể sáng trên bầu trời đêm.",key:2,offset:0},
 {answer:"ĐÈN ÔNG SAO",clue:"Chiếc đèn có hình ngôi sao quen thuộc dịp Trung Thu.",key:4,offset:0},
 {answer:"GIA ĐÌNH",clue:"Những người thường quây quần bên nhau trong đêm hội.",key:0,offset:1},
 {answer:"RƯỚC ĐÈN",clue:"Hoạt động với những chiếc đèn nhiều màu sắc.",key:0,offset:2},
 {answer:"RẰM",clue:"Cách gọi ngày 15 âm lịch, ngày diễn ra Tết Trung Thu.",key:1,offset:1},
 {answer:"MÚA LÂN",clue:"Tiết mục biểu diễn sôi động thường xuất hiện dịp Trung Thu.",key:0,offset:0}
];

const secret=["T","R","Ă","N","G","R","Ằ","M"];
const board=document.getElementById("board");
const clues=document.getElementById("clues");
const secretBox=document.getElementById("secret");

secret.forEach((x,i)=>{
  if(i===5){
    const s=document.createElement("div");
    s.className="secret-box secret-space";
    secretBox.appendChild(s);
  }
  const b=document.createElement("div");
  b.className="secret-box";
  b.id="secret-"+i;
  b.textContent="•";
  secretBox.appendChild(b);
});

data.forEach((r,ri)=>{
  const row=document.createElement("div");
  row.className="row";
  const num=document.createElement("div");
  num.className="num";
  num.textContent="("+(ri+1)+")";
  row.appendChild(num);

  const cells=document.createElement("div");
  cells.className="cells";

  for(let i=0;i<r.offset;i++){
    const blank=document.createElement("div");
    blank.style.cssText="width:45px;flex:0 0 45px";
    cells.appendChild(blank);
  }

  const answer=r.answer.replaceAll(" ","");
  [...answer].forEach((ch,ci)=>{
    const box=document.createElement("div");
    box.className="cell"+(ci===r.key?" key":"");
    const input=document.createElement("input");
    input.maxLength=1;
    input.dataset.row=ri;
    input.dataset.answer=ch;
    input.setAttribute("aria-label","Hàng "+(ri+1)+" ô "+(ci+1));
    input.addEventListener("input",()=>{
      input.value=input.value.normalize("NFC").toUpperCase().slice(0,1);
      const list=[...cells.querySelectorAll("input")];
      const p=list.indexOf(input);
      if(input.value && list[p+1]) list[p+1].focus();
    });
    box.appendChild(input);
    cells.appendChild(box);
  }
  row.appendChild(cells);
  board.appendChild(row);

  const c=document.createElement("div");
  c.className="clue";
  c.innerHTML="<b>Hàng "+(ri+1)+":</b> "+r.clue;
  clues.appendChild(c);
});

function checkGame(){
  let score=0;
  data.forEach((r,ri)=>{
    const inputs=[...document.querySelectorAll('input[data-row="'+ri+'"]')];
    const correct=inputs.length===r.answer.replaceAll(" ","").length &&
      inputs.every(x=>x.value.normalize("NFC").toUpperCase()===x.dataset.answer);

    if(correct){
      score++;
      document.getElementById("secret-"+ri).textContent=secret[ri];
    }else{
      document.getElementById("secret-"+ri).textContent="•";
    }
    inputs.forEach(x=>{
      x.parentElement.style.borderColor=correct?"#6baa76":"#d68c98";
    });
  });

  document.getElementById("score").textContent=score;

  if(score===8){
    document.getElementById("msg").textContent="🎉 Hoàn thành! Mật mã dọc là TRĂNG RẰM 🌕";
  }else{
    document.getElementById("msg").textContent="Bạn đã đúng "+score+"/8 hàng. Hãy kiểm tra lại các ô chữ nhé!";
  }
}

function resetGame(){
  document.querySelectorAll("input").forEach(x=>{
    x.value="";
    x.parentElement.style.borderColor="#475268";
  });
  secret.forEach((_,i)=>document.getElementById("secret-"+i).textContent="•");
  document.getElementById("score").textContent="0";
  document.getElementById("msg").textContent="";
}

document.getElementById("check").addEventListener("click",checkGame);
document.getElementById("reset").addEventListener("click",resetGame);
</script>
</body>
</html>
